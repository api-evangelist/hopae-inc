              "body": "{\n  \"providerId\": \"idin\",\n  \"requiredUserData\": [\n    {\n      \"field\": \"presetBank\",\n      \"type\": \"select\",\n      \"required\": true,\n      \"label\": \"Bank Selection\",\n      \"description\": \"Select your Dutch bank for iDIN verification\",\n      \"options\": [\n        {\n          \"value\": \"ABNANL2A\",\n          \"label\": \"ABN AMRO\"\n        },\n        {\n          \"value\": \"ABNANL2A\",\n          \"label\": \"ABN AMRO\"\n        }\n      ],\n      \"pattern\": \"^[A-Z]{2}[0-9]{9}$\"\n    },\n    {\n      \"field\": \"presetBank\",\n      \"type\": \"select\",\n      \"required\": true,\n      \"label\": \"Bank Selection\",\n      \"description\": \"Select your Dutch bank for iDIN verification\",\n      \"options\": [\n        {\n          \"value\": \"ABNANL2A\",\n          \"label\": \"ABN AMRO\"\n        },\n        {\n          \"value\": \"ABNANL2A\",\n          \"label\": \"ABN AMRO\"\n        }\n      ],\n      \"pattern\": \"^[A-Z]{2}[0-9]{9}$\"\n    }\n  ],\n  \"flowTypes\": [\n    \"redirect\"\n  ],\n  \"optionalUserData\": [\n    {\n      \"field\": \"presetBank\",\n      \"type\": \"select\",\n      \"required\": true,\n      \"label\": \"Bank Selection\",\n      \"description\": \"Select your Dutch bank for iDIN verification\",\n      \"options\": [\n        {\n          \"value\": \"ABNANL2A\",\n          \"label\": \"ABN AMRO\"\n        },\n        {\n          \"value\": \"ABNANL2A\",\n          \"label\": \"ABN AMRO\"\n        }\n      ],\n      \"pattern\": \"^[A-Z]{2}[0-9]{9}$\"\n    },\n    {\n      \"field\": \"presetBank\",\n      \"type\": \"select\",\n      \"required\": true,\n      \"label\": \"Bank Selection\",\n      \"description\": \"Select your Dutch bank for iDIN verification\",\n      \"options\": [\n        {\n          \"value\": \"ABNANL2A\",\n          \"label\": \"ABN AMRO\"\n        },\n        {\n          \"value\": \"ABNANL2A\",\n          \"label\": \"ABN AMRO\"