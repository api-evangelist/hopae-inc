{
  "opencollection": "1.0.0",
  "info": {
    "name": "hConnect Console - API Keys Workspace API - Activation API",
    "version": "1.0.0"
  },
  "items": [
    {
      "info": {
        "name": "Workspace API - Activation",
        "type": "folder"
      },
      "items": [
        {
          "info": {
            "name": "Get activation steps",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "https://sandbox.api.hopae.com/connect/v1/apps/:id/providers/:providerId/activation/steps",
            "params": [
              {
                "name": "id",
                "value": "",
                "type": "path"
              },
              {
                "name": "providerId",
                "value": "",
                "type": "path"
              }
            ],
            "auth": {
              "type": "bearer",
              "token": "{{bearerToken}}"
            }
          },
          "docs": "Get computed activation steps for a specific provider"
        },
        {
          "info": {
            "name": "Enable or disable provider",
            "type": "http"
          },
          "http": {
            "method": "PATCH",
            "url": "https://sandbox.api.hopae.com/connect/v1/apps/:id/providers/:providerId/activation",
            "params": [
              {
                "name": "id",
                "value": "",
                "type": "path"
              },
              {
                "name": "providerId",
                "value": "",
                "type": "path"
              }
            ],
            "body": {
              "type": "json",
              "data": "{}"
            },
            "auth": {
              "type": "bearer",
              "token": "{{bearerToken}}"
            }
          },
          "docs": "Enable or disable a provider"
        },
        {
          "info": {
            "name": "Submit activation form",
            "type": "http"
          },
          "http": {
            "method": "POST",
            "url": "https://sandbox.api.hopae.com/connect/v1/apps/:id/providers/:providerId/activation/form",
            "params": [
              {
                "name": "id",
                "value": "",
                "type": "path"
              },
              {
                "name": "providerId",
                "value": "",
                "type": "path"
              }
            ],
            "body": {
              "type": "json",
              "data": "{}"
            },
            "auth": {
              "type": "bearer",
              "token": "{{bearerToken}}"
            }
          },
          "docs": "Submit the activation request form for provider activation"
        },
        {
          "info": {
            "name": "Upload activation documents",
            "type": "http"
          },
          "http": {
            "method": "POST",
            "url": "https://sandbox.api.hopae.com/connect/v1/apps/:id/providers/:providerId/activation/documents",
            "params": [
              {
                "name": "id",
                "value": "",
                "type": "path"
              },
              {
                "name": "providerId",
                "value": "",
                "type": "path"
              }
            ],
            "auth": {
              "type": "bearer",
              "token": "{{bearerToken}}"
            }
          },
          "docs": "Upload documents required for provider activation"
        },
        {
          "info": {
            "name": "Delete an activation document",
            "type": "http"
          },
          "http": {
            "method": "DELETE",
            "url": "https://sandbox.api.hopae.com/connect/v1/apps/:id/providers/:providerId/activation/documents/:documentId",
            "params": [
              {
                "name": "id",
                "value": "",
                "type": "path"
              },
              {
                "name": "providerId",
                "value": "",
                "type": "path"
              },
              {
                "name": "documentId",
                "value": "",
                "type": "path"
              }
            ],
            "auth": {
              "type": "bearer",
              "token": "{{bearerToken}}"
            }
          },
          "docs": "Remove an uploaded activation document. Deletion is blocked once the document has been processed (approved) by review."
        }
      ]
    }
  ],
  "bundled": true
}